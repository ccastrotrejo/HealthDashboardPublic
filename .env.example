# ─────────────────────────────────────────────────────────────────────────────
# Health Dashboard environment variables
#
# This is a TEMPLATE. Initialize local configuration without overwriting it:
#   pnpm run setup
#
# Setup creates .env.local with mode 0600 and private athlete/data files.
# Fill provider credentials below, then run `pnpm auth whoop`, `pnpm auth strava`,
# or `pnpm auth garmin`. Auth saves tokens directly to .env.local without
# printing them; local sync saves rotated refresh tokens here too.
# .env.local and private/ are gitignored — NEVER commit secrets or publish data.
# Optional CI requires a PRIVATE repository and separately provisioned GitHub
# Actions Secrets. Local authorization does not upload credentials to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# Optional date-calculation override. Leave blank to use the timezone in
# private/athlete.json (the synthetic example uses UTC). Use an IANA name such
# as Europe/London; commands that do not load .env.local need a shell export.
USER_TIMEZONE=

# Whoop OAuth — get from https://developer-dashboard.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Saved by `pnpm auth whoop`; no manual token copy required for local use.
WHOOP_REFRESH_TOKEN=

# Strava OAuth — get from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Saved by `pnpm auth strava`; no manual token copy required for local use.
STRAVA_REFRESH_TOKEN=

# Garmin Connect — optional, unofficial integration. GARMIN_TOKEN_JSON preferred.
#
#   Mode A (preferred for local sync and private CI):
#     GARMIN_TOKEN_JSON — base64 of {oauth1, oauth2}, saved to .env.local by
#     `pnpm auth garmin`. Token reuse avoids repeated full SSO logins.
#
#   Mode B (local bootstrap):
#     GARMIN_EMAIL + GARMIN_PASSWORD — used by `pnpm auth garmin` for SSO.
#     Once GARMIN_TOKEN_JSON is saved, clear these two values. Without a token,
#     sync falls back to full SSO; do not configure that fallback in CI.
#
# Keep account MFA enabled. If the library cannot support your account's
# login/MFA requirements, leave Garmin unconfigured rather than weakening
# account protection. Treat all three values as secrets; base64 is not encryption.
GARMIN_TOKEN_JSON=
GARMIN_EMAIL=
GARMIN_PASSWORD=

# GitHub PAT for refresh-token write-back in PRIVATE GitHub Actions only.
# Local sync updates .env.local instead and does not need a GitHub PAT.
# Fine-grained, single-repo scope, permissions: Actions: r/w, Secrets: r/w
GH_PAT=
# Optional coordinates; Actions normally supplies GITHUB_REPOSITORY.
GH_OWNER=
GH_REPO=

# ─── AI generation ───────────────────────────────────────────────────────────
# Provider resolution, first match wins:
#   1. LLM_PROVIDER=copilot-cli — GitHub Copilot CLI subprocess, billed to the repo owner's
#      Copilot seat. What CI uses. Needs `npm install -g @github/copilot` locally; in Actions
#      the built-in GITHUB_TOKEN is enough given `copilot-requests: write`.
#   2. LLM_API_KEY (+ optional LLM_BASE_URL, LLM_MODEL)
#   3. OPENAI_API_KEY
# With none of them set every generator falls back to its deterministic
# template and the dashboard badges the card as "Fallback".
#
# GitHub Models (GITHUB_TOKEN + `permissions: models: read`) was the free default until it was
# retired on 2026-07-30; that endpoint returns HTTP 410 now.
#
# PRIVACY: these prompts carry sleep, HRV, resting heart rate and injury data. Since 2026-04-24
# GitHub may train on Copilot Free/Pro/Pro+/Max interactions unless you opt out at
# https://github.com/settings/copilot. Do that before using the copilot-cli provider.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
OPENAI_API_KEY=
# With copilot-cli this is a Copilot model name (e.g. gpt-5-mini), not an OpenAI model id.
LLM_MODEL=
# Per-task override. Month-long pattern detection is a much harder reasoning
# task than a fifteen-word headline and benefits from a stronger model.
LLM_MODEL_MONTHLY_PATTERNS=
# Overrides the 180s ceiling on a single Copilot CLI call. An agent round-trip on these payloads
# measures ~35-70s, against ~2s for a raw HTTP completion.
COPILOT_TIMEOUT_MS=

# Anomaly-escalation webhook. scripts/lib/notify.ts POSTs here when the anomaly
# combination escalates (e.g. elevated skin temp alongside elevated RHR — the
# classic pre-symptomatic infection pattern). No-ops when unset, but then that
# signal only surfaces if you happen to open the dashboard.
HEALTH_ESCALATION_WEBHOOK_URL=

# Vercel basic-auth gate (only used in middleware.ts on Vercel deploys)
DASHBOARD_USER=
DASHBOARD_PASS=
