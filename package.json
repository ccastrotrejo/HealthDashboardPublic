{
  "name": "health-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Self-hosted health dashboard with private Whoop, Strava and Garmin connections.",
  "imports": {
    "#athlete-config": "./scripts/lib/athlete-config.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsgo -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsgo -b && tsgo -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth": "tsx --env-file-if-exists=.env.local scripts/auth.ts",
    "setup": "tsx scripts/setup.ts",
    "export:public": "tsx scripts/export-public.ts",
    "audit:public": "tsx scripts/audit-public.ts",
    "sync": "tsx --env-file-if-exists=.env.local scripts/sync.ts",
    "sync:dry": "DRY_RUN=1 tsx --env-file-if-exists=.env.local scripts/sync.ts",
    "log": "tsx scripts/log.ts",
    "ai": "tsx --env-file-if-exists=.env.local scripts/ai-run.ts",
    "coach:prompt": "tsx scripts/coach.ts prompt",
    "coach:save": "tsx scripts/coach.ts save"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.9",
    "@astryxdesign/theme-neutral": "^0.1.9",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xmldom/xmldom": "0.9.12",
    "d3-brush": "3.0.0",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-time": "3.1.0",
    "garmin-connect": "^1.6.2",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "three": "0.185.1",
    "tweetnacl-sealedbox-js": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/d3-brush": "3.0.6",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.12",
    "@types/d3-shape": "3.2.0",
    "@types/d3-time": "3.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.185.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vercel/edge": "^1.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "astryx": {
    "theme": "@astryxdesign/theme-neutral"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.0"
}
